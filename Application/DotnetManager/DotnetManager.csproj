<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>true</PublishAot>
        <AssemblyName>dnm</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="../../.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="NuGet.Versioning"/>
        <PackageReference Include="Spectre.Console"/>
        <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Discovery/DotnetManager.InstalledDotnet/DotnetManager.InstalledDotnet.csproj"/>
        <ProjectReference Include="../../Discovery/DotnetManager.ReleaseMetadata/DotnetManager.ReleaseMetadata.csproj"/>
        <ProjectReference Include="../../Environment/DotnetManager.UserEnvironment/DotnetManager.UserEnvironment.csproj"/>
        <ProjectReference Include="../../Installation/DotnetManager.Installation/DotnetManager.Installation.csproj"/>
        <ProjectReference Include="../../Removal/DotnetManager.Removal/DotnetManager.Removal.csproj"/>
        <ProjectReference Include="../../Shared/DotnetManager.Core/DotnetManager.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DotnetManager.UnitTests"/>
    </ItemGroup>


</Project>
