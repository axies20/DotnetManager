<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PublishAot>true</PublishAot>
        <AssemblyName>dnm</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="NuGet.Versioning"/>
        <PackageReference Include="Spectre.Console"/>
        <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../DotnetManager.Core/DotnetManager.Core.csproj"/>
        <ProjectReference Include="../DotnetManager.Installation/DotnetManager.Installation.csproj"/>
        <ProjectReference Include="../DotnetManager.InstalledDotnet/DotnetManager.InstalledDotnet.csproj"/>
        <ProjectReference Include="../DotnetManager.ReleaseMetadata/DotnetManager.ReleaseMetadata.csproj"/>
        <ProjectReference Include="../DotnetManager.Removal/DotnetManager.Removal.csproj"/>
        <ProjectReference Include="../DotnetManager.UserEnvironment/DotnetManager.UserEnvironment.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DotnetManager.UnitTests"/>
    </ItemGroup>


</Project>
